{
  "name": "maplibre-gl-raster",
  "version": "0.1.0",
  "description": "Pure TypeScript tile server powered by GDAL WebAssembly for MapLibre GL JS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "maplibre-gl-raster": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/types/browser.d.ts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/types/browser.d.ts",
        "default": "./dist/browser.cjs"
      }
    },
    "./maplibre": {
      "import": {
        "types": "./dist/types/maplibre.d.ts",
        "default": "./dist/maplibre.mjs"
      },
      "require": {
        "types": "./dist/types/maplibre.d.ts",
        "default": "./dist/maplibre.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/server.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/types/react.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./style.css": "./dist/maplibre-gl-raster.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.examples.config.ts",
    "build": "npm run build:lib && npm run build:geolibre",
    "build:lib": "tsc -p tsconfig.build.json && vite build",
    "build:geolibre": "vite build --config vite.geolibre.config.ts",
    "build:examples": "vite build --config vite.examples.config.ts --base /maplibre-gl-raster/",
    "package:geolibre": "npm run build:geolibre && node scripts/package-geolibre-plugin.mjs",
    "serve:geolibre": "node scripts/serve-geolibre-plugin.mjs",
    "preview": "vite preview --config vite.examples.config.ts --base /maplibre-gl-raster/",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "fixtures:generate": "node scripts/generate-fixture.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "tileserver",
    "gdal",
    "geotiff",
    "cog",
    "webassembly",
    "raster",
    "xyz",
    "typescript"
  ],
  "author": "Qiusheng Wu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengeos/maplibre-gl-raster.git"
  },
  "peerDependencies": {
    "fastify": ">=4.0.0",
    "maplibre-gl": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "dependencies": {
    "@developmentseed/morecantile": "^0.7.0",
    "@fastify/cors": "^11.2.0",
    "commander": "^15.0.0",
    "d3-scale-chromatic": "^3.1.0",
    "fastify": "^5.8.5",
    "gdal3.js": "^2.8.1",
    "geotiff": "^3.0.5",
    "lru-cache": "^11.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^5.24.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
